# Guestbook ("Letters From Everyone") — Upstash Redis REST credentials.
# On Vercel: Storage → add "Upstash for Redis" and these are injected for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (or the UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN names)

# Optional: password for READING the letters (defaults to the one from your original site)
GUESTBOOK_READ_PASSWORD=120403
